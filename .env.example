# notification-service - African's Talking SMS (Sandbox)
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-api-key
AT_SMS_URL=https://api.sandbox.africastalking.com/version1/messaging

# notification-service - Firebase FCM
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Google Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# payment-service - Platform commission
COMMISSION_RATE=0.10

# payment-service - MTN MoMo (Sandbox)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=your-momo-collections-primary-key
MOMO_API_USER=your-api-user-uuid
MOMO_API_KEY=your-api-key
MOMO_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=https://webhook.site/anything
MOMO_CURRENCY=EUR

# Cloudinary - Profile pictures + booking photos
CLOUDINARY_CLOUD_NAME=your-cloud-name
