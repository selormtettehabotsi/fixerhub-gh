POSTGRES_USER=fixerhub
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=fixerhub

# notification-service - African's Talking SMS (Sandbox)
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-api-key
AT_SMS_URL=https://api.sandbox.africastalking.com/version1/messaging

# notification-service - Firebase FCM
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Google Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# payment-service - Platform commission
COMMISSION_RATE=0.10

# payment-service - Paystack
PAYSTACK_SECRET_KEY=sk_test_your-paystack-test-secret-key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://webhook.site/fixerhub-payment

# Cloudinary - Profile pictures + booking photos
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis host/port (default: localhost:6379 from docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# auth-service - Email OTP fallback (used when SMS fails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-app-password

# SECURITY — required (services fail to start without JWT_SECRET / GATEWAY_SECRET)
JWT_SECRET=<random-256-bit-hex, e.g. `openssl rand -hex 32`>
GATEWAY_SECRET=<random-256-bit-hex, e.g. `openssl rand -hex 32`>
ADMIN_EMAIL=<seed-admin-email>
ADMIN_PASSWORD=<seed-admin-password, min 8 chars + a number>
