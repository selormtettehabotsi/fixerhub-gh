{
  "expo": {
    "name": "FixerHub",
    "slug": "fixerhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fixerhub",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "splash": {
      "backgroundColor": "#a33900"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#a33900"
      },
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_KEY"
        }
      },
      "package": "com.fixerhub.app"
    },
    "ios": {
      "bundleIdentifier": "com.fixerhub.app",
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_KEY"
      }
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "color": "#a33900"
        }
      ],
      "expo-font"
    ]
  }
}
