{
  "expo": {
    "name": "FixerHub",
    "slug": "fixerhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fixerhub",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#a33900"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#a33900"
      },
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_KEY"
        }
      },
      "package": "com.fixerhub.app"
    },
    "ios": {
      "bundleIdentifier": "com.fixerhub.app",
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_KEY"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FixerHub to access your photos for booking and profile pictures.",
          "cameraPermission": "Allow FixerHub to use your camera for photos and KYC verification."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#a33900"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
