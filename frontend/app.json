{
  "expo": {
    "name": "FixerHub",
    "slug": "fixerhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fixerhub",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "54.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#a33900"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#a33900"
      },
      "googleServicesFile": "$GOOGLE_SERVICES_JSON",
      "config": {
        "googleMaps": {
          "apiKey": "MISSING_GOOGLE_MAPS_KEY"
        }
      },
      "package": "com.fixerhub.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.fixerhub.app",
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "MISSING_GOOGLE_MAPS_KEY"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FixerHub to access your photos for booking and profile pictures.",
          "cameraPermission": "Allow FixerHub to use your camera for photos and KYC verification."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#a33900"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "543ca2f0-bb1f-422c-bfc1-8354563713fe"
      }
    },
    "owner": "selormcyrils-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/543ca2f0-bb1f-422c-bfc1-8354563713fe"
    }
  }
}
